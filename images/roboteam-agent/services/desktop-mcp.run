#!/usr/bin/with-contenv bash
set -euo pipefail

exec /opt/roboteam-tools/node_modules/.bin/supergateway \
  --stdio /usr/local/bin/roboteam-computer-use-mcp \
  --outputTransport streamableHttp \
  --stateful \
  --sessionTimeout 600000 \
  --port 8100 \
  --streamableHttpPath /mcp \
  --healthEndpoint /health \
  --logLevel info
