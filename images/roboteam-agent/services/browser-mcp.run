#!/usr/bin/with-contenv bash
set -euo pipefail

for _ in $(seq 1 600); do
  if curl --fail --silent http://127.0.0.1:9222/json/version >/dev/null; then
    exec /opt/roboteam-tools/node_modules/.bin/playwright-mcp \
      --cdp-endpoint http://127.0.0.1:9222 \
      --host 0.0.0.0 \
      --port 8100 \
      --allowed-hosts '*'
  fi
  sleep 0.1
done

echo "visible Chromium CDP endpoint is unavailable" >&2
exit 1
