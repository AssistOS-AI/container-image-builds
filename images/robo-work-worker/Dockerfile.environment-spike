# Test-only Environment step 1 overlay. Product Dockerfile and smoke are separate.
FROM docker.io/assistos/robo-work-worker@sha256:ad60b288d0147b427db48387b54f636c5266ec145aafeb2d26e09578cf0901fd

USER root
# Only amd64 has been resolved. Transitive additions are observed in the lock,
# not pinned; no claim of a fully reproducible dependency closure is made.
RUN set -eux; \
    test "$(rpm --eval '%{_arch}')" = x86_64; \
    dnf install -y --setopt=ip_resolve=4 --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        podman-5:5.8.9-1.fc44.x86_64 \
        containers-common-5:0.67.2-1.fc44.noarch \
        crun-0:1.28-1.fc44.x86_64 \
        conmon-2:2.2.1-2.fc44.x86_64 \
        fuse-overlayfs-0:1.17-1.fc44.x86_64; \
    dnf clean all; \
    rm -rf /var/cache/dnf /var/cache/libdnf5

COPY --chmod=0444 environment-spike-packages.lock.json /usr/local/share/ploinky/environment-spike-packages.lock.json
COPY --chmod=0755 smoke-environment-spike.mjs /usr/local/share/ploinky/smoke-environment-spike.mjs

CMD ["node", "/usr/local/share/ploinky/smoke-environment-spike.mjs"]
